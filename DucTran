-- ================== HÀM GỬI DISCORD ==================
local function sendToDiscord(title, description, fields, color, ping)
    local content = ping and "@everyone" or ""
    
    local embed = {
        ["title"] = title,
        ["description"] = description,
        ["color"] = color or 16738790,
        ["fields"] = fields or {},
        ["footer"] = {
            ["text"] = "Blox Fruit Notifier • " .. os.date("%H:%M:%S %d/%m/%Y"),
        },
        ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    local data = {
        ["content"] = content,
        ["embeds"] = {embed}
    }
    
    local jsonData = game:GetService("HttpService"):JSONEncode(data)
    
    local requestTable = {
        Url = webhookUrl,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = jsonData
    }
    
    local success = false
    if syn and syn.request then
        success = pcall(function() syn.request(requestTable) end)
    elseif http_request then
        success = pcall(function() http_request(requestTable) end)
    elseif request then
        success = pcall(function() request(requestTable) end)
    else
        warn("❌ Executor không hỗ trợ webhook")
        return false
    end
    
    if success then
        print("✅ Đã gửi thông báo: " .. title)
    else
        warn("❌ Lỗi gửi webhook")
    end
    return success
end

-- ================== KIỂM TRA MELEE ==================
local function checkMelee()
    if hasNotifiedMelee then return end
    
    local meleeSkills = {}
    local player = game.Players.LocalPlayer
    
    -- Tìm trong kỹ năng của người chơi
    if player and player:FindFirstChild("Data") then
        for _, skill in pairs(player.Data:GetChildren()) do
            local skillName = skill.Name
            if skillName:find("Melee") or skillName:find("Black") or skillName:find("Electro") or skillName:find("Dragon") or skillName:find("Superhuman") then
                table.insert(meleeSkills, skillName)
            end
        end
    end
    
    -- Nếu có melee, gửi thông báo
    if #meleeSkills > 0 then
        local fields = {{
            name = "💪 **MELEE ĐANG CÓ:**",
            value = "```\n" .. table.concat(meleeSkills, "\n") .. "\n```",
            inline = false
        }}
        sendToDiscord("📊 DANH SÁCH MELEE", "Các kỹ năng Melee hiện tại:", fields, 5763719, false)
        hasNotifiedMelee = true
    end
end

