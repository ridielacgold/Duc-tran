-- [[ GEMINI HUB - VERSION 3.5 AUTO KILL ]] --
local Player = game.Players.LocalPlayer

-- Hàm tự động cầm vũ khí
local function EquipWeapon()
    pcall(function()
        local tool = Player.Backpack:FindFirstChild("Combat") or Player.Character:FindFirstChild("Combat")
        if tool and not Player.Character:FindFirstChild(tool.Name) then
            Player.Character.Humanoid:EquipTool(tool)
        end
    end)
end

-- GIAO DIỆN
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 200, 0, 100)
MainFrame.Position = UDim2.new(0.5, -100, 0.5, -50)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)

local Btn = Instance.new("TextButton", MainFrame)
Btn.Size = UDim2.new(1, -20, 1, -20)
Btn.Position = UDim2.new(0, 10, 0, 10)
Btn.Text = "AUTO KILL: OFF"
Btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
Btn.TextColor3 = Color3.new(1,1,1)

_G.AutoFarm = false
Btn.MouseButton1Click:Connect(function()
    _G.AutoFarm = not _G.AutoFarm
    Btn.Text = _G.AutoFarm and "AUTO KILL: ON" or "AUTO KILL: OFF"
    Btn.BackgroundColor3 = _G.AutoFarm and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(50, 50, 50)
    
    if _G.AutoFarm then
        task.spawn(function()
            while _G.AutoFarm do
                pcall(function()
                    EquipWeapon()
                    
                    -- Tìm quái gần nhất và còn sống
                    for _, v in pairs(game.Workspace.Enemies:GetChildren()) do
                        local humanoid = v:FindFirstChild("Humanoid")
                        local root = v:FindFirstChild("HumanoidRootPart")
                        
                        -- KIỂM TRA: Nếu có quái, có máu và máu > 0
                        if humanoid and root and humanoid.Health > 0 then
                            -- Kiểm tra khoảng cách (dưới 30 mét)
                            if (root.Position - Player.Character.HumanoidRootPart.Position).Magnitude < 30 then
                                
                                -- Vòng lặp đánh con quái này cho đến khi nó chết hoặc mình tắt Auto
                                repeat
                                    local args = {
                                        [1] = v:FindFirstChild("RightUpperLeg") or root,
                                        [2] = {},
                                        [4] = "058e7a71" -- Mã bảo mật bạn bắt được
                                    }
                                    game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterHit"):FireServer(unpack(args))
                                    task.wait(0.05) -- Tốc độ đánh cực nhanh
                                until humanoid.Health <= 0 or not _G.AutoFarm or not v.Parent
                            end
                        end
                    end
                end)
                task.wait(0.5) -- Quét tìm quái mới mỗi 0.5 giây
            end
        end)
    end
end)
