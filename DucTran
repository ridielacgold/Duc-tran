local Player = game.Players.LocalPlayer

-- 1. TỰ ĐỘNG CẦM COMBAT (EQUIP)
local function EquipWeapon()
    pcall(function()
        local args = { true }
        -- Lệnh bạn vừa tìm được để cầm Combat
        Player.Character:WaitForChild("Combat"):WaitForChild("EquipEvent"):FireServer(unpack(args))
    end)
end

-- 2. KHỞI TẠO GIAO DIỆN
