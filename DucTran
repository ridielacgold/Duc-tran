-- [[ GEMINI HUB - VERSION 7.0 AUTO FLY FARM ]] --
local Player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

-- Thông báo kích hoạt
game.StarterGui:SetCore("SendNotification", {
    Title = "Gemini V7.0";
    Text = "Đang bay đến vị trí quái...";
    Duration = 5;
})

-- Hàm ngăn nhân vật bị rơi hoặc bị rung khi bay
local function StopFalling()
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        local velocity = Player.Character.HumanoidRootPart:FindFirstChild("VelocityHandler") or Instance.new("BodyVelocity")
        velocity.Name = "VelocityHandler"
        velocity.Parent = Player.Character.HumanoidRootPart
        velocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        velocity.Velocity = Vector3.new(0, 0, 0)
    end
end

-- VÒNG LẶP CHÍNH: BAY VÀ ĐÁNH
task.spawn(function()
    while true do
        pcall(function()
            local Character = Player.Character
            local Root = Character:FindFirstChild("HumanoidRootPart")
            
            -- Tìm con quái Bandit gần nhất
            for _, v in pairs(game.Workspace.Enemies:GetChildren()) do
                if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    
                    -- LỆNH BAY: Giữ nhân vật ở trên đầu quái 6 mét
                    repeat
                        StopFalling()
                        Root.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 15, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        
                        -- KẾT HỢP LỆNH ĐÁNH CỦA BẠN
                        game:GetService("ReplicatedStorage").Modules.Net["RE/RegisterAttack"]:FireServer(0.5)
                        
                        local args = {
                            [1] = v:FindFirstChild("LeftHand") or v.HumanoidRootPart,
                            [2] = {},
                            [4] = "058e045b" -- Mã bảo mật của bạn
                        }
                        game:GetService("ReplicatedStorage").Modules.Net["RE/RegisterHit"]:FireServer(unpack(args))
                        
                        task.wait(0.1)
                    until v.Humanoid.Health <= 0 or not v.Parent
                end
            end
        end)
        task.wait(1) -- Đợi 1 giây để quét tìm quái mới
    end
end)
