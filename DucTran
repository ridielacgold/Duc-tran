-- ================== HÀM GỬI DISCORD ==================
local function sendToDiscord(title, description, fields, color)
    local embed = {
        ["title"] = title,
        ["description"] = description,
        ["color"] = color or 16738790,
        ["fields"] = fields or {},
        ["footer"] = {
            ["text"] = "Blox Fruit Account Info • " .. os.date("%H:%M:%S %d/%m/%Y"),
        },
        ["thumbnail"] = {
            ["url"] = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. game.Players.LocalPlayer.UserId .. "&width=420&height=420&format=png"
        },
        ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    local data = {
        ["content"] = "@everyone **THÔNG TIN TÀI KHOẢN**",
        ["embeds"] = {embed}
    }
    
    local jsonData = game:GetService("HttpService"):JSONEncode(data)
    
    local requestTable = {
        Url = webhookUrl,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = jsonData
    }
    
    local success = false
    if syn and syn.request then
        success = pcall(function() syn.request(requestTable) end)
    elseif http_request then
        success = pcall(function() http_request(requestTable) end)
    elseif request then
        success = pcall(function() request(requestTable) end)
    else
        warn("❌ Executor không hỗ trợ webhook")
        return false
    end
    
    if success then
        print("✅ Đã gửi thông tin account lên Discord")
    else
        warn("❌ Lỗi gửi webhook")
    end
    return success
end

-- ================== LẤY THÔNG TIN MELEE ==================
local function getMeleeInfo()
    local meleeList = {}
    local player = game.Players.LocalPlayer
    
    if player and player:FindFirstChild("Data") then
        for _, skill in pairs(player.Data:GetChildren()) do
            local skillName = skill.Name
            -- Các loại melee phổ biến
            if skillName:find("Melee") or skillName:find("Black") or skillName:find("Electro") or skillName:find("Dragon") or skillName:find("Superhuman") or skillName:find("Godhuman") then
                table.insert(meleeList, skillName)
            end
        end
    end
    
    if #meleeList > 0 then
        return "```\n" .. table.concat(meleeList, "\n") .. "\n```"
    else
        return "```\nChưa có melee\n```"
    end
end

-- ================== LẤY THÔNG TIN KIẾM ==================
local function getSwordInfo()
    local swordList = {}
    local backpack = game.Players.LocalPlayer.Backpack
    
    for _, item in pairs(backpack:GetChildren()) do
        -- Lọc các item là kiếm (có thể dựa vào tên hoặc class)
        if item:IsA("Tool") and (item.Name:find("Katana") or item.Name:find("Blade") or item.Name:find("Sword") or item.Name == "Yama" or item.Name == "Tushita" or item.Name == "Canvander" or item.Name == "Shisui" or item.Name == "Saddi" or item.Name == "Wando") then
            table.insert(swordList, item.Name)
        end
    end
    
    if #swordList > 0 then
        return "```\n" .. table.concat(swordList, "\n") .. "\n```"
    else
        return "```\nKhông có kiếm trong túi\n```"
    end
end

-- ================== LẤY THÔNG TIN TRÁI ĐANG DÙNG ==================
local function getCurrentFruit()
    local player = game.Players.LocalPlayer
    local fruitName = "Không có"
    
    -- Kiểm tra trong trang bị chính
    if player.Character then
        local equipped = player.Character:FindFirstChildOfClass("Tool")
        if equipped and equipped:FindFirstChild("Fruit") then
            fruitName = equipped.Name
        end
    end
    
    return fruitName
end

-- ================== LẤY LEVEL ==================
local function getLevel()
    local player = game.Players.LocalPlayer
    if player and player:FindFirstChild("Data") and player.Data:FindFirstChild("Level") then
        return player.Data.Level.Value
    end
    return "Unknown"
end

-- ================== LẤY BELI VÀ FRAGMENT ==================
local function getCurrency()
    local player = game.Players.LocalPlayer
    local beli = 0
    local fragment = 0
    
    if player and player:FindFirstChild("Data") then
        if player.Data:FindFirstChild("Beli") then
            beli = player.Data.Beli.Value
        end
        if player.Data:FindFirstChild("Fragment") then
            fragment = player.Data.Fragment.Value
        end
    end
    
    return beli, fragment
end

-- ================== LẤY THÔNG TIN PVP ==================
local function getPVPInfo()
    local player = game.Players.LocalPlayer
    local bounty = 0
    local honor = 0
    
    if player and player:FindFirstChild("Data") then
        if player.Data:FindFirstChild("Bounty") then
            bounty = player.Data.Bounty.Value
        end
        if player.Data:FindFirstChild("Honor") then
            honor = player.Data.Honor.Value
        end
    end
    
    return bounty, honor
end

-- ================== LẤY THỜI GIAN CHƠI ==================
local function getPlayTime()
    local player = game.Players.LocalPlayer
    if player and player:FindFirstChild("Data") and player.Data:FindFirstChild("PlayTime") then
        local seconds = player.Data.PlayTime.Value
        local hours = math.floor(seconds / 3600)
        local minutes = math.floor((seconds % 3600) / 60)
        return string.format("%d giờ %d phút", hours, minutes)
    end
    return "Unknown"
end

-- ================== GỬI BÁO CÁO ACCOUNT ==================
