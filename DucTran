-- Hàm tạo nút nhanh
local function CreateButton(name)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Text = name
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.TextColor3 = Color3.new(1,1,1)
    return btn
end

-- 2. CHỨC NĂNG AUTO ATTACK
_G.AutoAttack = false
local attackBtn = CreateButton("Auto Attack: OFF")

attackBtn.MouseButton1Click:Connect(function()
    _G.AutoAttack = not _G.AutoAttack
    
    if _G.AutoAttack then
        attackBtn.Text = "Auto Attack: ON"
        attackBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        task.spawn(function()
            while _G.AutoAttack do
                -- ĐOẠN CODE BẠN BẮT ĐƯỢC ĐÃ ĐƯỢC ĐƯA VÀO ĐÚNG CHỖ
                local args = { 0.5 }
                pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterAttack"):FireServer(unpack(args))
                end)
                task.wait(0.1)
            end
        end)
    else
        attackBtn.Text = "Auto Attack: OFF"
        attackBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

-- Đóng mở Menu
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

