-- NÚT BẬT/TẮT AUTO FARM
local AttackBtn = Instance.new("TextButton")
AttackBtn.Parent = MainFrame
AttackBtn.Size = UDim2.new(0, 160, 0, 45)
AttackBtn.Position = UDim2.new(0, 10, 0, 50)
AttackBtn.Text = "Auto Attack: OFF"
AttackBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
AttackBtn.TextColor3 = Color3.new(1,1,1)

_G.AutoFarm = false
AttackBtn.MouseButton1Click:Connect(function()
    _G.AutoFarm = not _G.AutoFarm
    if _G.AutoFarm then
        AttackBtn.Text = "Auto Attack: ON"
        AttackBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        
        -- Chạy vòng lặp đánh
        task.spawn(function()
            while _G.AutoFarm do
                EquipWeapon() -- Tự cầm vũ khí mỗi khi đánh
                
                local args = { 1 } -- Lệnh đánh bạn vừa tìm
                pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterAttack"):FireServer(unpack(args))
                end)
                
                task.wait(0.15) -- Thời gian nghỉ giữa các lần đánh
            end
        end)
    else
        AttackBtn.Text = "Auto Attack: OFF"
        AttackBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

