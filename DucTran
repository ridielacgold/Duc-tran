end

-- ================== QUÉT TRÁI TRÊN 1M ==================
local function scanForRareFruits()
    while task.wait(3) do  -- Quét mỗi 3 giây
        for _, obj in pairs(workspace:GetChildren()) do
            -- Bỏ qua nếu đã thông báo rồi
            if notifiedFruits[obj] then continue end
            
            -- Kiểm tra có phải trái cây không
            local isFruit = false
            local fruitName = ""
            local fruitPos = nil
            
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                fruitName = obj.Name
                fruitPos = obj.Handle.Position
                isFruit = true
            elseif obj.Name:find("Fruit") or obj.Name:find("fruit") then
                fruitName = obj.Name
                fruitPos = obj.Position
                isFruit = true
            end
            
            -- Nếu là trái cây, kiểm tra trong danh sách hiếm
            if isFruit and fruitName ~= "" then
                -- Chuẩn hóa tên trái để so sánh
                local normalizedName = fruitName:gsub("%.Fruit", "-Fruit")
                normalizedName = normalizedName:gsub(" ", "-")
                
                for rareName in pairs(rareFruits) do
                    if normalizedName:find(rareName) or fruitName:find(rareName:gsub("-Fruit", "")) then
                        -- Đánh dấu đã thông báo
                        notifiedFruits[obj] = true
                        
                        -- Tạo thông báo
                        local fields = {
                            {
                                name = "🍎 **TRÁI CÂY HIẾM:**",
                                value = "```\n" .. fruitName .. "\n```",
                                inline = true
                            },
                            {
                                name = "💰 **GIÁ TRỊ:**",
                                value = "```\nTRÊN 1 TRIỆU BELI\n```",
                                inline = true
                            },
                            {
                                name = "📍 **VỊ TRÍ:**",
                                value = "```\nX: " .. math.floor(fruitPos.X) .. " | Y: " .. math.floor(fruitPos.Y) .. " | Z: " .. math.floor(fruitPos.Z) .. "\n```",
                                inline = false
                            }
                        }
                        
                        sendToDiscord("🔥 PHÁT HIỆN TRÁI CÂY HIẾM!", 
                                     "Trái cây giá trị cao vừa xuất hiện!", 
                                     fields, 16738790, true)
                        
                        -- Tự động xóa khỏi danh sách sau 5 phút
                        task.delay(300, function()
                            notifiedFruits[obj] = nil
                        end)
                        
                        break
                    end
                end
            end
        end
    end
end

-- ================== KIỂM TRA ĐỊNH KỲ ==================
local function periodicCheck()
    while task.wait(30) do
        if not hasNotifiedMelee then
            checkMelee()
        end
        if not hasNotifiedSwords then
            checkLegendarySwords()
        end
    end
end

