-- [[ GEMINI HUB - VERSION 6.1 NO MENU (AUTO ATTACK ONLY) ]] --
-- Tự động bật đánh và chống văng, không chỉnh tốc độ chạy

local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

-- Thông báo kích hoạt
game.StarterGui:SetCore("SendNotification", {
    Title = "Gemini V6.1";
    Text = "Auto Farm đã bật (Tốc độ bình thường)";
    Duration = 5;
})

-- 1. HÀM TỰ ĐỘNG CẦM VŨ KHÍ
local function EquipWeapon()
    pcall(function()
        local tool = Player.Backpack:FindFirstChild("Combat") or Character:FindFirstChild("Combat")
        if tool and not Character:FindFirstChild(tool.Name) then
            Humanoid:EquipTool(tool)
        end
    end)
end

-- 2. VÒNG LẶP AUTO FARM CHỐNG VĂNG
task.spawn(function()
    while true do
        pcall(function()
            -- Luôn cầm vũ khí
            EquipWeapon()
            
            -- Lệnh vung tay để chống bị văng sát thương
            game:GetService("ReplicatedStorage").Modules.Net["RE/RegisterAttack"]:FireServer(0.5)
            
            -- Tìm quái xung quanh và gây sát thương
            for _, v in pairs(game.Workspace.Enemies:GetChildren()) do
                if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    -- Khoảng cách đánh an toàn
                    if (v.HumanoidRootPart.Position - Character.HumanoidRootPart.Position).Magnitude < 40 then
                        local args = {
                            [1] = v:FindFirstChild("LeftHand") or v:FindFirstChild("RightUpperLeg") or v.HumanoidRootPart,
                            [2] = {},
                            [4] = "058e045b" -- Mã bảo mật bạn đã lấy
                        }
                        game:GetService("ReplicatedStorage").Modules.Net["RE/RegisterHit"]:FireServer(unpack(args))
                    end
                end
            end
        end)
        task.wait(0.15) -- Tốc độ đánh mượt mà
    end
end)

print("Script TranDuc V6.1 đã chạy ngầm!")
