local WebhookURL = "https://discord.com/api/webhooks/1470656522777399431/LscNzrJSAPIQk20MO1X9N_YbzWbM4Lnk0pr2Ypo2EyMw0aj3lbFNLRHmURh8hQJSoDjX"

-- Lấy thông tin người chơi
local Player = game:GetService("Players").LocalPlayer
local Data = Player:WaitForChild("Data")
local Stats = {
    Level = Data.Level.Value,
    Beli = Data.Beli.Value,
    Fragments = Data.Fragments.Value,
    Fruit = Data.Fruit.Value
}

-- Hàm gửi dữ liệu về Discord
local function SendBloxStats(customMessage)
    local payload = {
        ["embeds"] = {{
            ["title"] = "🌊 **THÔNG TIN TÀI KHOẢN BLOX FRUITS** 🌊",
            ["color"] = 3447003, -- Màu xanh dương nước biển
            ["fields"] = {
                {["name"] = "👤 Tên nhân vật", ["value"] = "||" .. Player.Name .. "||", ["inline"] = true},
                {["name"] = "🆙 Cấp độ", ["value"] = tostring(Stats.Level), ["inline"] = true},
                {["name"] = "💰 Tiền (Beli)", ["value"] = "$" .. tostring(Stats.Level), ["inline"] = true},
                {["name"] = "💜 Điểm F", ["value"] = tostring(Stats.Fragments), ["inline"] = true},
                {["name"] = "🍎 Trái đang dùng", ["value"] = Stats.Fruit ~= "" and Stats.Fruit or "Chưa ăn", ["inline"] = false},
                {["name"] = "📢 Thông báo", ["value"] = customMessage or "Đang treo máy...", ["inline"] = false}
            },
            ["footer"] = {["text"] = "Cập nhật lúc: " .. os.date("%H:%M:%S")}
        }}
    }

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if httpRequest then
        httpRequest({
            Url = WebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = game:GetService("HttpService"):JSONEncode(payload)
        })
    else
        warn("Executor của bạn không hỗ trợ gửi HTTP Request!")
    end
end

-- Ví dụ: Gửi thông báo ngay khi chạy script
SendBloxStats("Vừa bắt đầu phiên treo máy mới!")
main()
