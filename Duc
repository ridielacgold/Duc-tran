        ["title"] = title,
        ["description"] = description,
        ["color"] = color or 16738790,
        ["fields"] = fields or {},
        ["footer"] = {
            ["text"] = "Blox Fruit Account Info • " .. os.date("%H:%M:%S %d/%m/%Y"),
        },
        ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    local data = {
        ["content"] = "@everyone **THÔNG TIN TÀI KHOẢN**",
        ["embeds"] = {embed}
    }
    
    local jsonData = game:GetService("HttpService"):JSONEncode(data)
    
    local requestData = {
        Url = webhookUrl,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = jsonData
    }
    
    if syn and syn.request then
        syn.request(requestData)
    elseif http_request then
        http_request(requestData)
    elseif request then
        request(requestData)
    end
end

-- Hàm lấy Melee thật sự
local function getRealMelee()
    local meleeList = {}
    local player = game.Players.LocalPlayer
    
    -- Danh sách melee trong game
    local meleeNames = {
        "Combat", "Dark Step", "Electric", "Water Kung Fu", "Dragon Breath",
        "Superhuman", "Death Step", "Sharkman Karate", "Electric Claw",
        "Dragon Talon", "Godhuman", "Sanguine Art"
    }
    
    -- Tìm trong Fighter
    if player:FindFirstChild("Fighter") then
        for _, v in pairs(player.Fighter:GetChildren()) do
            for _, meleeName in pairs(meleeNames) do
                if v.Name == meleeName then
                    table.insert(meleeList, meleeName)
                end
            end
        end
    end
    
    return meleeList
end

-- Hàm lấy Kiếm thật sự (chỉ kiếm, không lấy trái)
local function getRealSwords()
    local swordList = {}
    local player = game.Players.LocalPlayer
    
    -- Danh sách kiếm phổ biến (bạn có thể thêm)
    local swordNames = {
        "Katana", "Cutlass", "Dual Katana", "Iron Mace", "Pipe", "Dragon Trident",
        "Saber", "Dual Headed Blade", "Triple Katana", "Pole", "Bisento", "Soul Cane",
        "Jitte", "Cavender", "Dark Dagger", "Rengoku", "Yama", "Tushita",
        "Buddy Sword", "Canvander", "Shisui", "Saddi", "Wando", "Koko",
        "Dragonheart", "Spikey Trident", "True Triple Katana", "Twin Hooks",
        "Last Resort", "Fox Lamp", "Tushita", "Yama", "Canvander"
    }
    
    -- Kiểm tra trong Backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            -- Kiểm tra nếu là kiếm (theo tên)
            local isSword = false
            for _, swordName in pairs(swordNames) do
                if item.Name:find(swordName) then
                    isSword = true
                    break
                end
            end
            
            -- Nếu không tìm thấy trong danh sách, kiểm tra đặc điểm
            if not isSword and not item:FindFirstChild("Fruit") then
                -- Tool không có Fruit => có thể là kiếm
                isSword = true
            end
            
            if isSword then
                table.insert(swordList, item.Name)
            end
        end
    end
    
    -- Kiểm tra trong Character (đang cầm)
    if player.Character then
        local equipped = player.Character:FindFirstChildOfClass("Tool")
        if equipped then
            local isSword = false
            for _, swordName in pairs(swordNames) do
                if equipped.Name:find(swordName) then
                    isSword = true
                    break
                end
            end
            if not isSword and not equipped:FindFirstChild("Fruit") then
                isSword = true
            end
            if isSword and not table.find(swordList, equipped.Name) then
                table.insert(swordList, equipped.Name .. " (đang cầm)")
            end
        end
    end
    
    return swordList
end

-- Hàm lấy Trái cây
local function getFruits()
    local fruitList = {}
    local player = game.Players.LocalPlayer
    
    -- Kiểm tra trong Backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") and (item.Name:find("Fruit") or item:FindFirstChild("Fruit")) then
            table.insert(fruitList, item.Name .. " (trong túi)")
        end
    end
    
    -- Kiểm tra trong Character (đang cầm)
    if player.Character then
        local equipped = player.Character:FindFirstChildOfClass("Tool")
        if equipped and (equipped.Name:find("Fruit") or equipped:FindFirstChild("Fruit")) then
            if not table.find(fruitList, equipped.Name) then
                table.insert(fruitList, equipped.Name .. " (đang cầm)")
            end
        end
    end
    
    return fruitList
end

