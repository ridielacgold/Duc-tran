local Player = game:GetService("Players").LocalPlayer
local HttpService = game:GetService("HttpService")

-- Hàm lấy danh sách kiếm trong túi đồ
local function GetInventorySwords()
    local swords = {}
    -- Kiểm tra trong Backpack (đồ đang cầm) và Character
    local fullInven = Player.Backpack:GetChildren()
    -- Một số executor cần kiểm tra thêm folder Data hoặc dùng Remote để lấy full inventory
    -- Ở đây ta quét các item có ToolType là Sword (nếu có) hoặc dựa trên tên common
    
    -- Cách đơn giản nhất: Lấy tất cả item trong Backpack là Swords
    for _, item in pairs(Player.Backpack:GetChildren()) do
        if item:IsA("Tool") and item:FindFirstChild("Tooltip") and item.Tooltip == "Sword" then
            table.insert(swords, "⚔️ " .. item.Name)
        end
    end
    
    -- Kiểm tra cả những món đang đeo trên người
    for _, item in pairs(Player.Character:GetChildren()) do
        if item:IsA("Tool") and item:FindFirstChild("Tooltip") and item.Tooltip == "Sword" then
            table.insert(swords, "⚔️ " .. item.Name)
        end
    end

    if #swords == 0 then return "Không tìm thấy kiếm" end
    return table.concat(swords, "\n")
end

-- Hàm lấy Melee hiện tại
local function GetCurrentMelee()
    local melee = "Chưa xác định"
    for _, item in pairs(Player.Backpack:GetChildren()) do
        if item:IsA("Tool") and item:FindFirstChild("Tooltip") and item.Tooltip == "Melee" then
            melee = item.Name
        end
    end
    for _, item in pairs(Player.Character:GetChildren()) do
        if item:IsA("Tool") and item:FindFirstChild("Tooltip") and item.Tooltip == "Melee" then
            melee = item.Name
        end
    end
    return "👊 " .. melee
end

-- Hàm gửi Webhook
local function SendReport()
    local fields = {
        {
            ["name"] = "👊 Melee Đang Dùng",
            ["value"] = GetCurrentMelee(),
            ["inline"] = true
        },
        {
            ["name"] = "🎒 Danh Sách Kiếm",
            ["value"] = GetInventorySwords(),
            ["inline"] = false
        }
    }

    local data = {
        ["embeds"] = {{
            ["title"] = "⚔️ **BÁO CÁO TRANG BỊ - " .. Player.Name .. "**",
            ["color"] = 0x9b59b6, -- Màu tím huyền bí
            ["fields"] = fields,
            ["footer"] = {["text"] = "GitHub Repository • Logger v1.0"},
            ["timestamp"] = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    local request = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if request then
        request({
            Url = WebhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end
end

-- Chạy hàm
SendReport()
