-- Hàm lấy Melee thật sự
local function getRealMelee()
    local meleeList = {}
    local player = game.Players.LocalPlayer
    
    -- Tìm trong Fighter (nơi chứa melee)
    if player:FindFirstChild("Fighter") then
        for _, v in pairs(player.Fighter:GetChildren()) do
            if v:IsA("StringValue") or v:IsA("NumberValue") then
                local meleeName = v.Name
                -- Lọc các tên melee hợp lệ
                if meleeName ~= "Level" and meleeName ~= "Exp" then
                    table.insert(meleeList, meleeName)
                end
            end
        end
    end
    
    -- Nếu không tìm thấy, thử tìm trong Data
    if #meleeList == 0 and player:FindFirstChild("Data") then
        for _, v in pairs(player.Data:GetChildren()) do
            if v.Name:find("Melee") or v.Name:find("Black") or v.Name:find("Electro") or v.Name:find("Dragon") or v.Name:find("Superhuman") or v.Name:find("Godhuman") then
                table.insert(meleeList, v.Name)
            end
        end
    end
    
    return meleeList
end

-- Hàm lấy Kiếm thật sự
local function getRealSwords()
    local swordList = {}
    local player = game.Players.LocalPlayer
    
    -- Kiểm tra trong Backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            -- Lọc các tool là kiếm (có thể dựa vào tên hoặc class)
            table.insert(swordList, item.Name)
        end
    end
    
    -- Kiểm tra trong Character (đang cầm)
    if player.Character then
        local equipped = player.Character:FindFirstChildOfClass("Tool")
        if equipped and not table.find(swordList, equipped.Name) then
            table.insert(swordList, equipped.Name .. " (đang cầm)")
        end
    end
    
    return swordList
end

-- Hàm lấy Trái đang dùng thật sự
local function getRealFruit()
    local player = game.Players.LocalPlayer
    
    -- Kiểm tra trong Character (đang cầm)
    if player.Character then
        local equipped = player.Character:FindFirstChildOfClass("Tool")
        if equipped and (equipped.Name:find("Fruit") or equipped:FindFirstChild("Fruit")) then
            return equipped.Name
        end
    end
    
    -- Kiểm tra trong Backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item.Name:find("Fruit") or item:FindFirstChild("Fruit") then
            return item.Name .. " (trong túi)"
        end
    end
    
    return "Không có trái"
end

-- Hàm lấy thông tin chi tiết
local function getDetailedInfo()
    local player = game.Players.LocalPlayer
    local data = player:FindFirstChild("Data")
    
    -- Level
    local level = "Unknown"
    if data and data:FindFirstChild("Level") then
        level = data.Level.Value
    end
    
    -- Beli
    local beli = 0
    if data and data:FindFirstChild("Beli") then
        beli = data.Beli.Value
    end
    
    -- Fragment
    local fragment = 0
    if data and data:FindFirstChild("Fragment") then
        fragment = data.Fragment.Value
    end
    
    -- Bounty/Honor
    local bounty = 0
    local honor = 0
    if data and data:FindFirstChild("Bounty") then
        bounty = data.Bounty.Value
    end
    if data and data:FindFirstChild("Honor") then
        honor = data.Honor.Value
    end
    
    -- Stats (điểm chỉ số)
    local stats = {}
    if player:FindFirstChild("PlayerStats") then
        for _, stat in pairs(player.PlayerStats:GetChildren()) do
            if stat:IsA("NumberValue") then
                table.insert(stats, stat.Name .. ": " .. stat.Value)
            end
        end
    end
    
    return level, beli, fragment, bounty, honor, stats
end

