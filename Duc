-- DANH SÁCH CHUẨN
local FRUIT_KEYWORDS = {"Fruit", "Magma", "Flame", "Ice", "Sand", "Dark", "Light", "Rumble", "Quake", "Human", "String", "Diamond", "Gravity", "Love", "Spider", "Phoenix", "Portal", "Dragon", "Venom", "Shadow", "Dough", "Control", "Soul", "Leopard", "Mammoth", "TRex", "Sound", "Buddha"}
local MELEE_KEYWORDS = {"Electric Claw", "Superhuman", "Godhuman", "Death Step", "Sharkman Karate", "Dragon Talon", "Dragon Breath", "Dark Step", "Electric", "Water Kung Fu", "Combat", "Sanguine Art"}

-- Hàm lấy Trái cây
local function getFruits()
    local fruitList = {}
    local player = game.Players.LocalPlayer
    
    -- Kiểm tra trong Backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            for _, keyword in pairs(FRUIT_KEYWORDS) do
                if item.Name:find(keyword) or (item:FindFirstChild("Fruit")) then
                    table.insert(fruitList, item.Name .. " (trong túi)")
                    break
                end
            end
        end
    end
    
    -- Kiểm tra đang cầm
    if player.Character then
        local equipped = player.Character:FindFirstChildOfClass("Tool")
        if equipped then
            for _, keyword in pairs(FRUIT_KEYWORDS) do
                if equipped.Name:find(keyword) or (equipped:FindFirstChild("Fruit")) then
                    if not table.find(fruitList, equipped.Name) then
                        table.insert(fruitList, equipped.Name .. " (đang cầm)")
                    end
                    break
                end
            end
        end
    end
    
    return fruitList
end

-- Hàm lấy Melee
local function getMelee()
    local meleeList = {}
    local player = game.Players.LocalPlayer
    
    -- Tìm trong Fighter
    if player:FindFirstChild("Fighter") then
        for _, v in pairs(player.Fighter:GetChildren()) do
            for _, meleeName in pairs(MELEE_KEYWORDS) do
                if v.Name == meleeName then
                    table.insert(meleeList, meleeName)
                    break
                end
            end
        end
    end
    
    return meleeList
end

-- Hàm lấy Kiếm (chỉ kiếm thật, không lấy trái hay melee)
local function getSwords()
    local swordList = {}
    local player = game.Players.LocalPlayer
    
    -- Danh sách kiếm thật
    local SWORD_NAMES = {
        "Last Resort", "Yama", "Tushita", "Canvander", "Shisui", "Saddi", "Wando",
        "Katana", "Cutlass", "Saber", "Pipe", "Jitte", "Rengoku", "Buddy Sword",
        "Dragonheart", "Spikey Trident", "True Triple Katana", "Twin Hooks", "Koko",
        "Dark Dagger", "Cavender", "Soul Cane", "Bisento", "Pole", "Triple Katana",
        "Dual Katana", "Iron Mace", "Dragon Trident", "Fox Lamp"
    }
    
    -- Kiểm tra trong Backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            -- Bỏ qua nếu là trái cây
            local isFruit = false
            for _, keyword in pairs(FRUIT_KEYWORDS) do
                if item.Name:find(keyword) or (item:FindFirstChild("Fruit")) then
                    isFruit = true
                    break
                end
            end
            
            -- Bỏ qua nếu là melee
            local isMelee = false
            for _, meleeName in pairs(MELEE_KEYWORDS) do
                if item.Name == meleeName then
                    isMelee = true
                    break
                end
            end
            
            -- Nếu không phải trái cũng không phải melee => có thể là kiếm
            if not isFruit and not isMelee then
                table.insert(swordList, item.Name)
            end
        end
    end
    
    -- Kiểm tra đang cầm
    if player.Character then
        local equipped = player.Character:FindFirstChildOfClass("Tool")
        if equipped then
            local isFruit = false
            for _, keyword in pairs(FRUIT_KEYWORDS) do
                if equipped.Name:find(keyword) or (equipped:FindFirstChild("Fruit")) then
                    isFruit = true
                    break
                end
            end
            
            local isMelee = false
            for _, meleeName in pairs(MELEE_KEYWORDS) do
                if equipped.Name == meleeName then
                    isMelee = true
                    break
                end
            end
            
            if not isFruit and not isMelee and not table.find(swordList, equipped.Name) then
                table.insert(swordList, equipped.Name .. " (đang cầm)")
            end
        end
    end
    
    return swordList
end

